# ── 同步源（必填）──
# Open WebUI 实例地址，不带结尾斜杠
OPENWEBUI_URL=https://chat.example.com
# 在 Open WebUI「设置 → 账号 → API 密钥」里生成（管理员需先在后台开启 API Key 功能）
OPENWEBUI_API_KEY=sk-xxxxxxxxxxxxxxxx

# ── 阅读站（必填）──
# 访问密码，请用足够长的随机串
ARCHIVE_PASSWORD=

# ── 可选 ──
# 监听地址。默认只监听本机，配合 Cloudflare Tunnel / 反向代理使用；要直接对外开放改成 0.0.0.0
HOST=127.0.0.1
PORT=8090
# 自动同步间隔（分钟）
SYNC_INTERVAL_MINUTES=15
# 是否把对话里的图片/附件一并下载到本地（0 关闭）
SYNC_FILES=1
# 单个附件大小上限（MB），超过则跳过
MAX_FILE_MB=50
# 数据目录（SQLite 数据库 + 附件）
# DATA_DIR=./data
